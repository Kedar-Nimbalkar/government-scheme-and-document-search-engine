{
  "name": "team06-search",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "node --env-file=.env apps/api/server.js",
    "dev:web": "node --env-file=.env node_modules/vite/bin/vite.js apps/web",
    "build": "vite build apps/web",
    "dev:e2": "python -m uvicorn engines.e2.main:app --host 127.0.0.1 --port 8001 --env-file .env",
    "test": "node --test tests/*.test.js",
    "smoke": "node --env-file=.env scripts/smoke.mjs"
  }
}
