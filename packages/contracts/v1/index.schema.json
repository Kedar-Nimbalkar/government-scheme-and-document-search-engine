{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed index files v1",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/segment"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "version",
        "generation",
        "segments",
        "passage_count",
        "avg_passage_length",
        "document_frequency"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.json$"
          }
        },
        "passage_count": {
          "type": "integer",
          "minimum": 0
        },
        "avg_passage_length": {
          "type": "number",
          "minimum": 0
        },
        "document_frequency": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "version",
        "passages",
        "postings"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          }
        },
        "postings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/posting"
            }
          }
        }
      }
    },
    "passage": {
      "type": "object",
      "required": [
        "passage_id",
        "doc_id",
        "page_no",
        "text",
        "length"
      ],
      "properties": {
        "passage_id": {
          "type": "integer",
          "minimum": 1
        },
        "doc_id": {
          "type": "integer",
          "minimum": 1
        },
        "page_no": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "posting": {
      "type": "object",
      "required": [
        "passage_id",
        "positions"
      ],
      "properties": {
        "passage_id": {
          "type": "integer",
          "minimum": 1
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
